# =============================================================================
# docker-set control plane API
# Copy to .env and fill in the values (the .env file is gitignored)
# =============================================================================

# Absolute path to the docker-set repository on the HOST.
# The same path is mounted inside the container so that bind mounts issued
# by the scripts resolve correctly on the host Docker daemon.
DOCKER_SET_ROOT=

# Bearer token protecting /api/* (min 32 chars).
# Generate one: openssl rand -hex 32
API_TOKEN=

# HMAC SHA-256 secret protecting /hooks/github/* (min 32 chars).
# Must match the "Secret" field of the GitHub webhook.
# Generate one: openssl rand -hex 32
WEBHOOK_SECRET=

# Listen address inside the container (the compose port mapping and the
# image HEALTHCHECK assume port 9000)
LISTEN_ADDR=:9000

# Maximum number of create/deploy jobs running at the same time
MAX_CONCURRENT_DEPLOYS=1
